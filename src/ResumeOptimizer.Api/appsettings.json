{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": "resume_optimizer",
    "ChunksCollectionName": "resume_chunks",
    "AnalysesCollectionName": "analyses"
  },
  "Gemini": {
    "ApiKey": "",
